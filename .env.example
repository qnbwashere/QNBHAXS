# Instagram credentials (personal account)
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password

# football-data.org free API key — sign up at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_api_key_here

# Telegram bot — get token from @BotFather, get your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_numeric_chat_id_here

# Optional: how often to post (minutes). Posts randomly between MIN and MAX.
POST_INTERVAL_MIN=10
POST_INTERVAL_MAX=20
